direction: right

tasks: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  name: TEXT
  runner: TEXT
  workspace: TEXT
  status: INTEGER
  command: INTEGER
  version: BIGINT
  archived: BOOLEAN
  auto_archive: BIGINT
  namespace: TEXT
  shell_session: TEXT
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

task_links: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  task_id: BIGINT {constraint: foreign_key}
  relevance: TEXT
  url: TEXT
  title: TEXT
  subscribe: BOOLEAN
  routing_key: TEXT
  created_at: TIMESTAMP
}

events: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  task_id: BIGINT {constraint: foreign_key}
  type: TEXT
  wake: BOOLEAN
  payload: JSONB
  xid: XID8
  created_at: TIMESTAMP
}

log_chunks: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  task_id: BIGINT {constraint: foreign_key}
  version: BIGINT
  data: BYTEA
  created_at: TIMESTAMP
}

schedules: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  created_by: TEXT {constraint: foreign_key}
  name: TEXT
  workspace: TEXT
  runner: TEXT
  namespace: TEXT
  instructions: JSONB
  auto_archive: BIGINT
  cron_expr: TEXT
  timezone: TEXT
  enabled: BOOLEAN
  next_run_at: TIMESTAMP
  last_run_at: TIMESTAMP
  last_task_id: BIGINT {constraint: foreign_key}
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
}

workspaces: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  runner_id: TEXT
  name: TEXT
  description: TEXT
  updated_at: TIMESTAMP
}

keys: {
  shape: sql_table
  id: UUID {constraint: primary_key}
  org_id: BIGINT {constraint: foreign_key}
  name: TEXT
  token_hash: TEXT {constraint: unique}
  scopes: "TEXT[]"
  expires_at: TIMESTAMP
  created_at: TIMESTAMP
}

users: {
  shape: sql_table
  id: TEXT {constraint: primary_key}
  email: TEXT {constraint: unique}
  name: TEXT
  github_user_id: BIGINT {constraint: unique}
  github_username: TEXT
  atlassian_account_id: TEXT {constraint: unique}
  atlassian_username: TEXT
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
  default_org_id: BIGINT {constraint: foreign_key}
}

orgs: {
  shape: sql_table
  id: BIGSERIAL {constraint: primary_key}
  name: TEXT
  owner: TEXT {constraint: foreign_key}
  atlassian_webhook_secret: TEXT
  routing_rules: JSONB
  custom_event_types: JSONB
  github_installation_id: BIGINT
  created_at: TIMESTAMP
  updated_at: TIMESTAMP
  archived: BOOLEAN
}

org_members: {
  shape: sql_table
  org_id: BIGINT {constraint: [primary_key; foreign_key]}
  user_id: TEXT {constraint: [primary_key; foreign_key]}
  role: TEXT
  created_at: TIMESTAMP
}

# Relationships
org_members.org_id -> orgs.id
task_links.task_id -> tasks.id
tasks.org_id -> orgs.id
events.org_id -> orgs.id
events.task_id -> tasks.id
workspaces.org_id -> orgs.id
keys.org_id -> orgs.id
org_members.user_id -> users.id
orgs.owner -> users.id
users.default_org_id -> orgs.id
log_chunks.org_id -> orgs.id
log_chunks.task_id -> tasks.id
schedules.org_id -> orgs.id
schedules.created_by -> users.id
schedules.last_task_id -> tasks.id
